{
  "openapi": "3.1.0",
  "info": {
    "title": "SikPoket API",
    "version": "1.8.0",
    "description": "Local-first encrypted bookmark vault — SikPoket exposes a Streamable HTTP MCP server and a small HTTP API for health and discovery. All vault data is client-side (chrome.storage.local, AES-GCM), so the hosted API is read-only discovery + MCP tools. Versioning via URL path (/api/v1/) and header (API-Version). Deprecation via Sunset/Deprecation headers. RateLimit headers on all API responses. See https://sikpoket.vercel.app/llms.txt and https://sikpoket.vercel.app/developers",
    "contact": {
      "name": "Sik",
      "email": "hello@sikpoket.app",
      "url": "https://sikpoket.vercel.app/contact"
    },
    "license": {
      "name": "MIT",
      "url": "https://github.com/njrankitsam11-gif/SikPoket/blob/master/LICENSE"
    }
  },
  "servers": [
    {
      "url": "https://sikpoket.vercel.app",
      "description": "Production (unversioned, defaults to v1)"
    },
    {
      "url": "https://sikpoket.vercel.app/v1",
      "description": "Versioned API v1 — path versioning (/v1/)"
    },
    {
      "url": "https://sikpoket.vercel.app/api/v1",
      "description": "Versioned API v1 — alias"
    }
  ],
  "tags": [
    { "name": "mcp", "description": "Model Context Protocol — Streamable HTTP" },
    { "name": "discovery", "description": "Sitemaps, llms.txt, OpenAPI" },
    { "name": "health", "description": "Health and diagnostics" }
  ],
  "paths": {
    "/.well-known/mcp": {
      "get": {
        "operationId": "getMcpHandshake",
        "summary": "MCP handshake — discovery",
        "description": "Returns MCP server manifest (Streamable HTTP). Use GET for discovery, POST for JSON-RPC. Versioned via API-Version header (1.8.0). See https://modelcontextprotocol.io",
        "tags": ["mcp"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "MCP manifest",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "API-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["mcp_version", "transport", "tools"],
                  "properties": {
                    "mcp_version": { "type": "string", "example": "2025-06-18" },
                    "name": { "type": "string", "example": "sikpoket" },
                    "transport": { "type": "string", "example": "streamable-http" },
                    "endpoint": { "type": "string", "format": "uri", "example": "https://sikpoket.vercel.app/api/mcp" },
                    "tools": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "description"],
                        "properties": {
                          "name": { "type": "string", "description": "Tool name for function calling" },
                          "description": { "type": "string", "description": "Human-readable tool description" },
                          "inputSchema": {
                            "type": "object",
                            "description": "JSON Schema for tool arguments",
                            "properties": {
                              "type": { "type": "string" },
                              "properties": { "type": "object", "additionalProperties": true },
                              "required": { "type": "array", "items": { "type": "string" } }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "operationId": "postMcpWellKnown",
        "summary": "MCP Streamable HTTP via well-known",
        "description": "Proxy to POST /api/mcp — JSON-RPC 2.0 for MCP tools. Supports initialize, tools/list, tools/call. Versioned.",
        "tags": ["mcp"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/McpJsonRpcRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC response",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpJsonRpcResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/mcp": {
      "get": {
        "operationId": "getMcp",
        "summary": "MCP handshake (api)",
        "description": "Same as GET /.well-known/mcp but canonical API endpoint. Returns 200 with MCP manifest. Versioned.",
        "tags": ["mcp"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "MCP manifest",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["mcp_version", "transport", "tools"],
                  "properties": {
                    "mcp_version": { "type": "string", "example": "2025-06-18" },
                    "transport": { "type": "string", "example": "streamable-http" },
                    "tools": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["name", "description"],
                        "properties": {
                          "name": { "type": "string" },
                          "description": { "type": "string" },
                          "inputSchema": { "type": "object", "description": "Typed input schema" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" }
        }
      },
      "post": {
        "operationId": "postMcp",
        "summary": "MCP Streamable HTTP JSON-RPC",
        "description": "Invoke MCP tools. Local-first: tools operate on client vault, server echoes hint. Methods: initialize, tools/list, tools/call with params {name, arguments}. Versioned.",
        "tags": ["mcp"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/McpJsonRpcRequest" },
              "examples": {
                "toolsList": {
                  "summary": "List tools",
                  "value": { "jsonrpc": "2.0", "id": 1, "method": "tools/list" }
                },
                "toolsCall": {
                  "summary": "Call search_vault",
                  "value": { "jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": { "name": "search_vault", "arguments": { "query": "react" } } }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JSON-RPC success",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/McpJsonRpcResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/v1/mcp": {
      "get": {
        "operationId": "getMcpV1",
        "summary": "MCP handshake v1 (versioned path)",
        "description": "Versioned alias for GET /api/mcp. Prefer /api/v1/mcp for versioned clients.",
        "tags": ["mcp"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "MCP manifest v1",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "API-Version": { "$ref": "#/components/headers/ApiVersion" },
              "Deprecation": { "$ref": "#/components/headers/Deprecation" },
              "Sunset": { "$ref": "#/components/headers/Sunset" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["mcp_version", "transport"],
                  "properties": {
                    "mcp_version": { "type": "string" },
                    "transport": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Health check",
        "description": "Returns service health and version. Useful for uptime checks. Rate limited 60/min.",
        "tags": ["health"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "Healthy",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
              "API-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "version"],
                  "properties": {
                    "status": { "type": "string", "example": "ok", "description": "Health status" },
                    "version": { "type": "string", "example": "1.8.0", "description": "Semver" },
                    "uptime": { "type": "number", "example": 123.4, "description": "Uptime seconds" },
                    "endpoint": { "type": "string", "format": "uri" },
                    "openapi": { "type": "string", "format": "uri" },
                    "mcp": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/sitemap.xml": {
      "get": {
        "operationId": "getSitemap",
        "summary": "Sitemap",
        "description": "XML sitemap of all indexable URLs. SikPoket on Vercel.",
        "tags": ["discovery"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "XML sitemap",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
              "API-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/xml": {
                "schema": {
                  "type": "object",
                  "description": "Sitemap response",
                  "properties": {
                    "urlset": { "type": "string", "description": "XML urlset" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/TooManyRequests" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/llms.txt": {
      "get": {
        "operationId": "getLlmsTxt",
        "summary": "LLMs.txt agent guide",
        "description": "When to use SikPoket, tool list, and sitemap for agents. SikPoket on Vercel.",
        "tags": ["discovery"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "llms.txt",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }
            },
            "content": {
              "text/plain": {
                "schema": {
                  "type": "object",
                  "description": "llms.txt guide",
                  "properties": {
                    "whenToUse": { "type": "string" },
                    "sitemap": { "type": "string", "format": "uri" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "operationId": "getOpenApi",
        "summary": "OpenAPI spec",
        "description": "This document. Versioned via API-Version header and /v1/ path. SikPoket on Vercel.",
        "tags": ["discovery"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "OpenAPI JSON",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
              "API-Version": { "$ref": "#/components/headers/ApiVersion" }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "OpenAPI 3.1 document with SikPoket API",
                  "properties": {
                    "openapi": { "type": "string" },
                    "info": { "type": "object" },
                    "paths": { "type": "object" }
                  },
                  "required": ["openapi", "info"]
                }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/developers": {
      "get": {
        "operationId": "getDevelopersPortal",
        "summary": "Developer portal",
        "description": "HTML portal with API keys, quickstart, sandbox. Vercel hosted SikPoket.",
        "tags": ["discovery"],
        "parameters": [{ "$ref": "#/components/parameters/ApiVersionHeader" }],
        "responses": {
          "200": {
            "description": "HTML portal",
            "headers": {
              "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }
            },
            "content": {
              "text/html": {
                "schema": {
                  "type": "object",
                  "description": "Developer portal HTML",
                  "properties": {
                    "title": { "type": "string" },
                    "content": { "type": "string" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "ApiVersionHeader": {
        "name": "API-Version",
        "in": "header",
        "description": "API version, e.g. 1.8.0 or v1. Defaults to v1. Use X-API-Version alias supported.",
        "required": false,
        "schema": { "type": "string", "example": "1.8.0" }
      }
    },
    "headers": {
      "RateLimitLimit": {
        "description": "Max requests per window (60/min)",
        "schema": { "type": "integer", "example": 60 }
      },
      "RateLimitRemaining": {
        "description": "Remaining requests in window",
        "schema": { "type": "integer", "example": 59 }
      },
      "RateLimitReset": {
        "description": "Seconds until window resets",
        "schema": { "type": "integer", "example": 42 }
      },
      "ApiVersion": {
        "description": "Current API version",
        "schema": { "type": "string", "example": "1.8.0" }
      },
      "Deprecation": {
        "description": "Deprecation flag, RFC 9745",
        "schema": { "type": "string", "example": "true" }
      },
      "Sunset": {
        "description": "Sunset date for deprecated version, RFC 8594",
        "schema": { "type": "string", "format": "date-time", "example": "2027-08-25T00:00:00Z" }
      },
      "RetryAfter": {
        "description": "Seconds to wait before retry after 429",
        "schema": { "type": "integer", "example": 60 }
      }
    },
    "schemas": {
      "McpJsonRpcRequest": {
        "type": "object",
        "required": ["jsonrpc", "id", "method"],
        "properties": {
          "jsonrpc": { "type": "string", "example": "2.0", "description": "JSON-RPC version" },
          "id": { "type": "integer", "example": 1, "description": "Request ID" },
          "method": { "type": "string", "enum": ["initialize", "tools/list", "tools/call"], "example": "tools/list", "description": "MCP method" },
          "params": {
            "type": "object",
            "description": "Method params",
            "properties": {
              "name": { "type": "string", "example": "search_vault", "description": "Tool name" },
              "arguments": { "type": "object", "additionalProperties": true, "description": "Tool arguments, typed per tool" }
            }
          }
        }
      },
      "McpJsonRpcResponse": {
        "type": "object",
        "required": ["jsonrpc", "id"],
        "properties": {
          "jsonrpc": { "type": "string", "example": "2.0" },
          "id": { "type": "integer", "example": 1 },
          "result": {
            "type": "object",
            "description": "Result object with protocolVersion, capabilities, tools",
            "properties": {
              "protocolVersion": { "type": "string", "example": "2025-06-18" },
              "capabilities": { "type": "object", "description": "Server capabilities" },
              "serverInfo": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "version": { "type": "string" }
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["name", "description"],
                  "properties": {
                    "name": { "type": "string" },
                    "description": { "type": "string" },
                    "inputSchema": { "type": "object", "description": "JSON Schema for tool" }
                  }
                }
              },
              "content": { "type": "array", "items": { "type": "object" } }
            }
          },
          "error": { "type": "object", "description": "JSON-RPC error" }
        }
      },
      "Error": {
        "type": "object",
        "required": ["error", "code", "message", "hint", "status"],
        "properties": {
          "error": { "type": "string", "example": "Not Found", "description": "Human error title" },
          "code": { "type": "string", "example": "RESOURCE_NOT_FOUND", "description": "Machine code" },
          "message": { "type": "string", "description": "Detailed message" },
          "hint": { "type": "string", "description": "Recovery hint" },
          "status": { "type": "integer", "example": 404, "description": "HTTP status" },
          "docs": { "type": "string", "format": "uri", "description": "Docs URL" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Bad request — JSON error",
        "headers": {
          "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          },
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "NotFound": {
        "description": "Not found — JSON error",
        "headers": {
          "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          },
          "application/problem+json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "TooManyRequests": {
        "description": "Too many requests — rate limited",
        "headers": {
          "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" },
          "RateLimit-Remaining": { "$ref": "#/components/headers/RateLimitRemaining" },
          "RateLimit-Reset": { "$ref": "#/components/headers/RateLimitReset" },
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      },
      "InternalError": {
        "description": "Internal error — JSON error",
        "headers": {
          "RateLimit-Limit": { "$ref": "#/components/headers/RateLimitLimit" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}