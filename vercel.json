{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/dashboard/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "Accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/index.md"
    },
    {
      "source": "/about",
      "has": [{ "type": "header", "key": "Accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/about/index.md"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "Accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/contact/index.md"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "header", "key": "Accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/privacy/index.md"
    },
    {
      "source": "/dashboard",
      "has": [{ "type": "header", "key": "Accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/dashboard/index.md"
    },
    { "source": "/.well-known/mcp", "destination": "/api/mcp" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/", "destination": "/dashboard/index.html" },
    { "source": "/standalone", "destination": "/dashboard/standalone.html" },
    { "source": "/standalone.html", "destination": "/dashboard/standalone.html" },
    { "source": "/qr-helper.js", "destination": "/qr-helper.js" },
    { "source": "/app.css", "destination": "/dashboard/app.css" },
    { "source": "/app.js", "destination": "/dashboard/app.js" },
    { "source": "/infographic", "destination": "/infographic.html" },
    { "source": "/blueprint", "destination": "/infographic.html" }
  ],
  "redirects": []
}
