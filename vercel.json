{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Vary", "value": "Accept, Accept-Encoding" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "RateLimit-Limit", "value": "60" },
        { "key": "RateLimit-Remaining", "value": "59" },
        { "key": "RateLimit-Reset", "value": "42" },
        { "key": "API-Version", "value": "1.8.0" },
        { "key": "Deprecation", "value": "false" },
        { "key": "Sunset", "value": "Sat, 25 Aug 2027 00:00:00 GMT" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/dashboard/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/.well-known/mcp",
      "headers": [{ "key": "Content-Type", "value": "application/json" }, { "key": "Access-Control-Allow-Origin", "value": "*" }]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Content-Type", "value": "application/xml" }, { "key": "RateLimit-Limit", "value": "60" }, { "key": "RateLimit-Remaining", "value": "59" }, { "key": "RateLimit-Reset", "value": "42" }, { "key": "API-Version", "value": "1.8.0" }]
    },
    {
      "source": "/404.html",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/(.*).md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    },
    {
      "source": "/index.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Vary", "value": "Accept, Accept-Encoding" }
      ]
    },
    {
      "source": "/openapi.json",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }, { "key": "Access-Control-Allow-Origin", "value": "*" }, { "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/developers",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/developers/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/vercel",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/vercel/index.html",
      "headers": [{ "key": "Vary", "value": "Accept, Accept-Encoding" }]
    },
    {
      "source": "/api/health",
      "headers": [{ "key": "Content-Type", "value": "application/json; charset=utf-8" }, { "key": "Vary", "value": "Accept, Accept-Encoding" }]
    }
  ],
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/", "/about", "/contact", "/privacy", "/dashboard", "/developers", "/vercel", "/.well-known/mcp"]
  },
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/index.md"
    },
    {
      "source": "/about",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/about/index.md"
    },
    {
      "source": "/contact",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/contact/index.md"
    },
    {
      "source": "/privacy",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/privacy/index.md"
    },
    {
      "source": "/dashboard",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/dashboard/index.md"
    },
    {
      "source": "/developers",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/developers/index.md"
    },
    {
      "source": "/vercel",
      "has": [{ "type": "header", "key": "accept", "value": ".*text/markdown.*" }],
      "destination": "/api/markdown?path=/vercel/index.md"
    },
    { "source": "/.well-known/mcp", "destination": "/api/mcp" },
    { "source": "/api/v1/mcp", "destination": "/api/mcp" },
    { "source": "/api/v1/health", "destination": "/api/health" },
    { "source": "/api/v1/openapi.json", "destination": "/openapi.json" },
    { "source": "/developers", "destination": "/developers/index.html" },
    { "source": "/vercel", "destination": "/vercel/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" },
    { "source": "/dashboard", "destination": "/dashboard/index.html" },
    { "source": "/dashboard/", "destination": "/dashboard/index.html" },
    { "source": "/standalone", "destination": "/dashboard/standalone.html" },
    { "source": "/standalone.html", "destination": "/dashboard/standalone.html" },
    { "source": "/qr-helper.js", "destination": "/qr-helper.js" },
    { "source": "/app.css", "destination": "/dashboard/app.css" },
    { "source": "/app.js", "destination": "/dashboard/app.js" },
    { "source": "/infographic", "destination": "/infographic.html" },
    { "source": "/blueprint", "destination": "/infographic.html" },
    { "source": "/(.*)", "destination": "/api/404" }
  ],
  "redirects": []
}
